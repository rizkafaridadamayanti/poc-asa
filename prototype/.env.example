PORT=3000
LOG_LEVEL=info
AUTH_DIR=./auth_session

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=asa_karang_taruna

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Auth
JWT_SECRET=change-me-to-a-random-string
# Kode pendaftaran akun dashboard ("Kode Pengurus"). Kalau diisi, siapa pun boleh
# daftar asal tahu kode ini. Kalau dikosongkan, pendaftaran otomatis tertutup
# setelah akun pertama dibuat.
DASHBOARD_PASSWORD=

# WA destinations (JIDs)
REPORT_TO_JID=628xxxxxxxxxx@s.whatsapp.net
TEST_GROUP_JID=120363...@g.us

# Outbound anti-ban jitter
SEND_MIN_DELAY_MS=1000
SEND_MAX_DELAY_MS=3000

# Optional: DIGEST_CRON=0 7 * * *
# Optional: WEEKLY_STATS_CRON=0 7 * * 1
